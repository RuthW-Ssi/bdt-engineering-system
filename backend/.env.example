# Database — local Docker Postgres (docker compose up -d postgres)
DATABASE_URL="postgresql://postgres:<DB_PASSWORD>@127.0.0.1:5432/bdt_dev?schema=public"

PORT=3000
NODE_ENV=development

# File storage (Sprint 3+ shop drawings)
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_PATH=./storage

# GCS driver (staging/production only — leave unset for local dev, which
# always stays on the local driver above)
FILE_STORAGE_GCS_BUCKET=
FILE_STORAGE_GCS_CREDENTIALS_JSON=

# Cutting Plan — external Python parsing service (Cloud Run, IAM-authenticated;
# local dev needs `gcloud auth application-default login` for ID-token minting)
CUTTING_PLAN_API_URL=https://bdt-cutting-plan-service-jr5hvzmn5q-an.a.run.app

# Production scheduler — backend-schedule/ (FastAPI) on Cloud Run, IAM-authenticated
# like the cutting-plan service (ADR-0015). Backs POST /schedule/runs; unset → 500
# "Scheduler service is not configured". Unlike the cutting-plan parser it WRITES to
# its own DATABASE_URL, so NEVER point local NestJS at the staging scheduler (it would
# overwrite staging's schedule versions). For local work run backend-schedule against
# your local DB (`uvicorn app.main:app --port 8100`) and set http://localhost:8100.
# The client still mints a Google ID token for any URL, so local runs also need
# `gcloud auth application-default login` (same as the cutting-plan client).
# The staging URL lives only in .github/workflows/deploy-backend.yml.
SCHEDULER_API_URL=

# Sprint 23: BIM Viewer — Autodesk Platform Services (APS) app credentials
# Create an app at https://aps.autodesk.com — needs Data Management + Model Derivative APIs enabled
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BIM_BUCKET_KEY=bdt-bim-staging
APS_DRAWING_BUCKET_KEY=bdt-drawing-staging
